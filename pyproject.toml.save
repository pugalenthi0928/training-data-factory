[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "training-data-robo"
version = "0.1.0"
description = "Enterprise-style training data factory for LLMs"
authors = [{ name = "Pugalenthi Magendran" }]
requires-python = ">=3.9"
dependencies = []

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
